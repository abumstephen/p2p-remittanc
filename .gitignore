# Root level gitignore for p2p-remittanc monorepo

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Environment variables (NEVER commit secrets!)
.env
.env.local
.env.*.local
.env.production
*.key
*.pem

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Logs
logs/
*.log

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Kiro workspace - AI development tools
.kiro/

# Personal notes and drafts
starter.md
23-10-2026/

# Database files (if using local DB for testing)
*.sqlite
*.sqlite3
*.db

# Package manager lock files (choose one strategy)
# Option 1: Keep lock files (recommended for consistency)
# Option 2: Ignore them (uncomment below if team prefers flexibility)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
